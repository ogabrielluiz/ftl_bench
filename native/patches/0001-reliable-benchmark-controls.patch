+bool hs_benchmark_set_weapon_autofire(bool enabled)
+{
+    CApp* app = Global::GetInstance()->GetCApp();
+    if (!app || !app->gui) return false;
+    app->gui->combatControl.weapControl.SetAutofiring(enabled, false);
+    return true;
+}
+
+bool hs_benchmark_victory()
+{
+    CApp* app = Global::GetInstance()->GetCApp();
+    if (!app || !app->gui || !app->world || !app->world->bStartedGame) return false;
+    return app->gui->alreadyWon || (app->gui->gameover && app->gui->gameOverScreen.bVictory);
+}
+
+bool hs_benchmark_set_difficulty(int difficulty)
+{
+    CApp* app = Global::GetInstance()->GetCApp();
+    if (difficulty < 0 || difficulty > 2 || !Global::difficulty || !app ||
+        !app->world || app->world->bStartedGame || !app->menu.bOpen) return false;
+    *Global::difficulty = difficulty;
+    return *Global::difficulty == difficulty;
+}
+
+int hs_benchmark_difficulty()
+{
+    // The game and Hyperspace difficulty logic use this settings pointer. The
+    // legacy WorldManager currentDifficulty layout is not reliable on Windows.
+    return Global::difficulty ? *Global::difficulty : -1;
+}
+
+const char* hs_benchmark_player_blueprint()
+{
+    static std::string blueprint;
+    blueprint.clear();
+    CApp* app = Global::GetInstance()->GetCApp();
+    if (!app || !app->world || !app->world->bStartedGame) return blueprint.c_str();
+    ShipManager* ship = Global::GetInstance()->GetShipManager(0);
+    if (ship) blueprint = ship->myBlueprint.blueprintName;
+    return blueprint.c_str();
+}
+
+int hs_benchmark_run_score()
+{
+    CApp* app = Global::GetInstance()->GetCApp();
+    if (!app || !app->world || !app->world->bStartedGame || !Global::difficulty) return -1;
+    ScoreKeeper* keeper = Global::GetInstance()->GetScoreKeeper();
+    int difficulty = *Global::difficulty;
+    if (!keeper || difficulty < 0 || difficulty > 2) return -1;
+    // FTL 1.6.9 ScoreKeeper::Save, 0x442bcd..0x442c20 in the Windows executable:
+    // current scrap + 20*ships destroyed + 10*explored beacons, times difficulty.
+    // Read current-run StatTrackers, not the TopScore snapshot updated by Save.
+    float modifier = difficulty == 2 ? 1.5f : difficulty == 1 ? 1.25f : 1.f;
+    return static_cast<int>(modifier * (keeper->stats[2].current +
+                                       20 * keeper->stats[0].current +
+                                       10 * keeper->stats[1].current));
+}
+
+const char* hs_benchmark_score_components()
+{
+    static char buffer[256];
+    buffer[0] = '\0';
+    if (hs_benchmark_run_score() < 0) return buffer;
+    ScoreKeeper* keeper = Global::GetInstance()->GetScoreKeeper();
+    std::snprintf(buffer, sizeof(buffer),
+                  "{\"scrap_collected\":%d,\"ships_destroyed\":%d,\"beacons_explored\":%d,\"difficulty\":%d}",
+                  keeper->stats[2].current, keeper->stats[0].current,
+                  keeper->stats[1].current, *Global::difficulty);
+    return buffer;
+}
+
+const char* hs_benchmark_capabilities()
+{
+    return "{\"native_protocol\":4,\"global_autofire_control\":true,\"hacking_idle_ready\":true,\"victory\":true,\"setup_identity\":true,\"seeded_easy_setup\":true,\"live_score\":true}";
+}
