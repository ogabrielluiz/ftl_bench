+HOOK_METHOD_PRIORITY(BlueprintManager, GetUnusedCrewName, -1000000, (bool* isMale_ret) -> std::string)
+{
+    using namespace BenchmarkFreshStartSeed;
+    ++totals.names;
+    if (state.pending) {
