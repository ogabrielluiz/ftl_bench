+const char* hs_benchmark_economy_state()
+{
+    static std::string buffer;
+    Global* global = Global::GetInstance();
+    CApp* app = global->GetCApp();
+    ShipManager* player = economy_player(app);
+    const bool started = app && app->world && app->gui && app->world->bStartedGame && player;
+    const bool available = started && upgrades_available(app, player);
+    std::ostringstream json;
+    json << std::boolalpha << "{\"native_protocol\":5,\"sector_navigation_version\":1,\"beacon_navigation_version\":1,\"upgrade_available\":" << available
+         << ",\"systems\":[";
+    bool comma = false;
+    if (started) for (ShipSystem* system : player->vSystemList) {
+        if (!system) continue;
+        const int price = next_system_cost(system);
+        const bool can = available && price >= 0 && player->currentScrap >= price &&
+                         player->CanUpgrade(system->iSystemType, 1) == 1;
+        if (comma) json << ',';
+        comma = true;
+        json << "{\"system_id\":" << system->iSystemType
+             << ",\"current_max_power\":" << system->powerState.second
+             << ",\"max_level\":" << system->maxLevel << ",\"next_upgrade_cost\":";
+        json_cost(json, price);
+        json << ",\"can_upgrade\":" << can << '}';
+    }
+    json << "],\"reactor\":";
+    PowerManager* power = started ? PowerManager::GetPowerManager(player->iShipId) : nullptr;
+    if (power) {
+        const CustomShipDefinition& def = CustomShipSelect::GetInstance()->GetDefinition(
+            player->myBlueprint.blueprintName);
+        const int price = next_reactor_cost(player, power);
+        json << "{\"current_max_power\":" << power->currentPower.second
+             << ",\"max_level\":" << def.maxReactorLevel << ",\"next_upgrade_cost\":";
+        json_cost(json, price);
+        json << ",\"can_upgrade\":" << (available && price >= 0 &&
+                player->currentScrap >= price && player->CanUpgrade(17, 1) == 1) << '}';
+    } else json << "null";
+    const StarMap* map = started ? &app->world->starMap : nullptr;
+    const bool can_wait = started && fuel_context_available(app, player) &&
+                         (!map->bOpen || map->waitButton.bActive);
+    const auto navigation = travel_context(app, player);
+    const char* navigation_reason = navigation.refusal_reason();
+    json << ",\"navigation\":{\"can_jump\":" << (navigation_reason == nullptr)
+         << ",\"enemy_defeat_pending\":" << navigation.enemy_defeat_pending
+         << ",\"drive_current\":" << navigation.charge
+         << ",\"drive_max\":" << navigation.required_charge << ",\"reason\":";
+    if (navigation_reason) json << '"' << navigation_reason << '"';
+    else json << "null";
+    json << "},\"fuel_recovery\":{\"out_of_fuel\":" << (started && player->fuel_count < 1)
+         << ",\"distress_on\":" << (map && map->distressButton.state)
+         << ",\"can_wait\":" << can_wait << ",\"waiting\":" << (map && map->waiting.running)
+         << "}}";
+    buffer = json.str();
+    return buffer.c_str();
+}
