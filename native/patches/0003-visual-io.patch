+namespace {
+ShipManager* economy_player(CApp* app)
+{
+    // Global::GetShipManager dereferences CApp/world and also returns the hangar
+    // preview ship. Economy controls must never target that preview or stale run.
+    if (!app || !app->world || !app->gui || !app->world->bStartedGame) return nullptr;
+    CompleteShip* ship = app->world->playerShip;
+    return ship ? ship->shipManager : nullptr;
+}
+
+BenchmarkEconomy::Context economy_context(CApp* app, ShipManager* player, bool allowMap)
+{
+    BenchmarkEconomy::Context context;
+    if (!app || !app->world || !app->gui || !player) return context;
+    CommandGui& gui = *app->gui;
+    StarMap& map = app->world->starMap;
+    context.started = app->world->bStartedGame && gui.shipComplete &&
+                      gui.shipComplete->shipManager == player;
+    context.main_menu = app->menu.bOpen;
+    context.game_over = gui.gameover || gui.alreadyWon;
+    context.destroyed = player->bDestroyed;
+    context.mid_warp = player->bJumping;
+    context.pending_travel = map.readyToTravel;
+    context.arrival_complete = gui.jumpComplete; // persists true at a settled beacon
+    context.pending_sector = map.bChoosingNewSector;
+    context.waiting = map.waiting.running;
+    context.modal = gui.choiceBoxOpen || gui.choiceBox.bOpen || gui.menuBox.bOpen ||
+                    gui.optionsBox.bOpen || gui.inputBox.bOpen || gui.gameOverScreen.bOpen ||
+                    gui.shipScreens.bOpen || gui.storeScreens.bOpen || gui.upgradeScreen.bOpen ||
+                    gui.crewScreen.bOpen || gui.equipScreen.bOpen || gui.leaveCrewDialog.bOpen ||
+                    gui.writeErrorDialog.bOpen || (!allowMap && map.bOpen);
+    for (FocusWindow* window : gui.focusWindows) {
+        if (window && window->bOpen && (!allowMap || window != &map)) context.modal = true;
+    }
+    return context;
+}
+
+bool enemy_defeat_pending(CApp* app)
+{
+    if (!app || !app->world || !app->world->playerShip) return false;
+    CompleteShip* enemy = app->world->playerShip->enemyShip;
+    ShipManager* manager = enemy ? enemy->shipManager : nullptr;
+    if (!manager) return false;
+    // ShipAI::Destroyed requires physical hull destruction AND DestroyedDone;
+    // its one-shot flag is set when WorldManager consumes the native death event.
+    // Read that flag; calling Destroyed() itself would consume the event here.
+    if (manager->ship.bDestroyed) {
+        return BenchmarkRouting::hull_defeat_pending(manager->bDestroyed,
+            manager->ship.DestroyedDone(), enemy->shipAI.destroyed);
+    }
+    // CompleteShip::DeadCrew also has a Hyperspace hook that can queue events.
+    // Read the vanilla counters instead: clone-ready crew count only while the
+    // clone bay works; automated ships cannot lose by crew elimination.
+    CrewMemberFactory* factory = Global::GetInstance()->GetCrewFactory();
+    return factory && BenchmarkRouting::crew_defeat_pending(
+        manager->_targetable.hostile, manager->bAutomated, factory->GetCrewCount(true),
+        factory->GetEnemyCloneCount(), manager->GetSystemHealth(13) != 0);
+}
+
+BenchmarkRouting::TravelContext travel_context(CApp* app, ShipManager* player)
+{
+    BenchmarkRouting::TravelContext context;
+    context.game = economy_context(app, player, true);
+    if (!app || !app->world || !app->gui || !player) return context;
+    context.button_active = app->gui->ftlButton.bActive;
+    context.engines = player->SystemFunctions(1);
+    context.piloting = player->SystemFunctions(6);
+    context.fuel = player->fuel_count;
+    context.charge = player->jump_timer.first;
+    context.required_charge = player->jump_timer.second;
+    context.enemy_defeat_pending = enemy_defeat_pending(app);
+    return context;
+}
+
+bool upgrades_available(CApp* app, ShipManager* player)
+{
+    return economy_context(app, player, false).ready() && app->gui->upgradeButton.bActive;
+}
+
+ShipSystem* upgrade_system(ShipManager* player, int id)
+{
+    if (!player) return nullptr;
+    // Do not pass an untrusted id into the engine's unchecked systemKey array.
+    for (ShipSystem* system : player->vSystemList) {
+        if (system && system->iSystemType == id) return system;
+    }
+    return nullptr;
+}
+
+int next_system_cost(ShipSystem* system)
+{
+    if (!system) return -1;
+    BlueprintManager* blueprints = Global::GetInstance()->GetBlueprints();
+    if (!blueprints) return -1;
+    const SystemBlueprint* blueprint = blueprints->GetSystemBlueprint(
+        ShipSystem::SystemIdToName(system->iSystemType));
+    if (!blueprint) return -1;
+    // UpgradeBox::MouseClick reads the base cap, not a temporary power boost.
+    return BenchmarkEconomy::system_cost(system->powerState.second, system->maxLevel,
+                                         blueprint->upgradeCosts);
+}
+
+int next_reactor_cost(ShipManager* player, PowerManager* power)
+{
+    if (!player || !power) return -1;
+    const CustomShipDefinition& def = CustomShipSelect::GetInstance()->GetDefinition(
+        player->myBlueprint.blueprintName);
+    return BenchmarkEconomy::reactor_cost(power->currentPower.second, def.maxReactorLevel,
+                                          def.reactorPrices, def.reactorPriceIncrement);
+}
+
+bool fuel_context_available(CApp* app, ShipManager* player)
+{
+    if (!economy_context(app, player, true).ready() || player->fuel_count >= 1) return false;
+    // Opening the map must be legal through the ordinary FTL button. Once open,
+    // its own active buttons control the recovery actions.
+    return app->world->starMap.bOpen || (app->gui->ftlButton.bActive &&
+           player->jump_timer.first >= player->jump_timer.second &&
+           player->SystemFunctions(1) && player->SystemFunctions(6));
+}
+
+StarMap* fuel_map(CApp* app, ShipManager* player)
+{
+    if (!fuel_context_available(app, player)) return nullptr;
+    StarMap& map = app->world->starMap;
+    if (!map.bOpen) map.Open();
+    if (!map.bOpen) return nullptr;
+    // Refresh the native active bits. No turn is advanced here: waiting is false
+    // and pending travel/sector transitions were refused before opening the map.
+    map.OnLoop();
+    return map.outOfFuel ? &map : nullptr;
+}
+
+
+void json_cost(std::ostringstream& json, int cost)
+{
+    if (cost < 0) json << "null";
+    else json << cost;
+}
+}
+
+bool hs_benchmark_upgrade_system(int system_id)
+{
+    Global* global = Global::GetInstance();
+    CApp* app = global->GetCApp();
+    ShipManager* player = economy_player(app);
+    if (!upgrades_available(app, player)) return false;
+    ShipSystem* system = upgrade_system(player, system_id);
+    const int price = next_system_cost(system);
+    if (!system || price < 0 || player->CanUpgrade(system_id, 1) != 1) return false;
+    return BenchmarkEconomy::purchase(true, price, player->currentScrap,
+        [system]() { return system->powerState.second; },
+        [player, system_id]() { player->UpgradeSystem(system_id, 1); },
+        [player](int amount) { player->ModifyScrapCount(-amount, false); });
+}
+
+bool hs_benchmark_upgrade_reactor()
+{
+    Global* global = Global::GetInstance();
+    CApp* app = global->GetCApp();
+    ShipManager* player = economy_player(app);
+    if (!upgrades_available(app, player)) return false;
+    PowerManager* power = PowerManager::GetPowerManager(player->iShipId);
+    const int price = next_reactor_cost(player, power);
+    if (!power || price < 0 || player->CanUpgrade(17, 1) != 1) return false;
+    return BenchmarkEconomy::purchase(true, price, player->currentScrap,
+        [power]() { return power->currentPower.second; },
+        [player]() { player->UpgradeSystem(17, 1); },
+        [player](int amount) { player->ModifyScrapCount(-amount, false); });
+}
+
+bool hs_benchmark_wait_for_fuel()
+{
+    Global* global = Global::GetInstance();
+    CApp* app = global->GetCApp();
+    StarMap* map = fuel_map(app, economy_player(app));
