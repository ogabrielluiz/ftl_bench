diff --git a/Benchmark_Routing.h b/Benchmark_Routing.h
new file mode 100644
index 0000000..5dfc158
--- /dev/null
+++ b/Benchmark_Routing.h
@@ -0,0 +1,79 @@
+#pragma once
+#include "Benchmark_Economy.h"
+#include <vector>
+
+namespace BenchmarkRouting {
+// FTLButton::MouseClick and CommandGui::LButtonDown both require a full native
+// timer, including outside combat. Never substitute enemy absence/death for it.
+struct TravelContext {
+    BenchmarkEconomy::Context game;
+    bool button_active = false;
+    bool engines = false;
+    bool piloting = false;
+    bool enemy_defeat_pending = false;
+    int fuel = 0;
+    float charge = 0.f;
+    float required_charge = 0.f;
+
+    const char* refusal_reason() const
+    {
+        if (!game.started || game.main_menu) return "game_unavailable";
+        if (game.game_over || game.destroyed) return "game_over";
+        if (game.mid_warp) return "mid_warp";
+        if (game.pending_travel || game.pending_sector) return "transition_pending";
+        if (game.waiting) return "fuel_wait_pending";
+        if (game.modal) return "modal_open";
+        if (fuel < 1) return "no_fuel";
+        if (!button_active) return "ftl_button_inactive";
+        if (!engines) return "engines_unavailable";
+        if (!piloting) return "piloting_unavailable";
+        if (!(charge >= required_charge)) return "drive_charging";
+        return nullptr;
+    }
+};
+
+inline bool hull_defeat_pending(bool destroyed, bool animation_done, bool native_processed)
+{
+    return destroyed && (!animation_done || !native_processed);
+}
+
+// Accepted surrender retains a live ship object. Only the native combat
+// hostility flag makes that surviving ship block a sector departure.
+inline bool sector_enemy_blocks(bool hostile, bool destroyed)
+{
+    return hostile && !destroyed;
+}
+
+// Native crew defeat uses the factory's surviving/clone crew counters and the
+// automation flag. It does not require a hull explosion. Once WorldManager
+// clears hostility its death event was handled; an open reward dialog is modal.
+inline bool crew_defeat_pending(bool hostile, bool automated, int crew, int clones,
+                                bool clone_system_functioning)
+{
+    return hostile && !automated &&
+           (crew - (clone_system_functioning ? 0 : clones)) == 0;
+}
+
+template<class Neighbors, class Travel>
+bool request_beacon(const TravelContext& context, int index, const Neighbors& neighbors,
+                    Travel travel)
+{
+    if (context.refusal_reason() || index < 0 ||
+        index >= static_cast<int>(neighbors.size()) || !neighbors[index]) return false;
+    travel(neighbors[index]);
+    return true;
+}
+
+// Sector buttons and NeighboringSector use global indices into StarMap.sectors.
+// GetRandomSectorChoice generates a sector type (0..2), not one of these indices.
+template<class Neighboring, class Random>
+int choose_sector_index(int count, Neighboring neighboring, Random random)
+{
+    std::vector<int> choices;
+    for (int index = 0; index < count; ++index) {
+        if (neighboring(index)) choices.push_back(index);
+    }
+    if (choices.empty()) return -1;
+    return choices[static_cast<unsigned>(random()) % choices.size()];
+}
+}
diff --git a/Benchmark_Visual.h b/Benchmark_Visual.h
new file mode 100644
index 0000000..71a346e
--- /dev/null
+++ b/Benchmark_Visual.h
@@ -0,0 +1,207 @@
+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+// Pure helpers shared by the engine binding and executable offline regressions.
+namespace BenchmarkVisual {
+// Native world time is owned explicitly by the visual controller. The permit
+// survives the post-world Lua tick through that frame's render: ship rendering
+// also advances jump trackers. Ambient renders never gain a world permit.
+struct FrameClock {
+    // Each admitted update represents one declared 1/60 second step. FTL's
+    // conventional duration conversions multiply SpeedFactor by 1/16.
+    static float fixed_speed_factor() { return 16.f / 60.f; }
+    bool owned=false,advancing=false,frame_permitted=false,world_updated=false;
+    uint64_t world_updates=0;
+    void control(bool enabled,bool advance) {
+        if (!enabled) { owned=false; advancing=false; frame_permitted=false; world_updated=false; return; }
+        if (!owned) { frame_permitted=false; world_updated=false; }
+        owned=true; advancing=advance;
+    }
+    void begin_frame() { frame_permitted=!owned || advancing; world_updated=false; }
+    bool update_permitted() const { return !owned || frame_permitted; }
+    void completed_world_update() {
+        if (owned && frame_permitted && !world_updated) { ++world_updates; world_updated=true; }
+    }
+    bool render_permitted() const { return !owned || (frame_permitted && world_updated); }
+    void finish_render() { frame_permitted=false; world_updated=false; }
+};
+template <typename FPS>
+inline void apply_fixed_frame_speed(FPS& fps, const FrameClock& clock) {
+    if (clock.owned && clock.frame_permitted) fps.SpeedFactor=FrameClock::fixed_speed_factor();
+}
+inline bool choice_queued(bool open,int selected,size_t choices) {
+    return open && selected>=0 && static_cast<size_t>(selected)<choices;
+}
+// A process-lifetime monitor armed by the first visual capture. Recapturing
+// never erases interference. Coordinates are the physical SIL mouse position,
+// independent of the cursor moved by synthetic CApp input.
+struct ExternalInputGuard {
+    uint64_t generation=0;
+    unsigned synthetic_depth=0;
+    bool armed=false,detected=false;
+    float mouse_x=0.f,mouse_y=0.f;
+    void arm(float x,float y) {
+        if (armed) return;
+        mouse_x=x; mouse_y=y; armed=true;
+    }
+    void observe(bool meaningful,bool movement,float x=0.f,float y=0.f) {
+        if (synthetic_depth) return;
+        const bool changed=movement && (x!=mouse_x || y!=mouse_y);
+        if (movement) { mouse_x=x; mouse_y=y; }
+        if (!armed || !(meaningful || changed)) return;
+        ++generation; detected=true;
+    }
+};
+struct SyntheticInputScope {
+    ExternalInputGuard& guard;
+    explicit SyntheticInputScope(ExternalInputGuard& value) : guard(value) { ++guard.synthetic_depth; }
+    ~SyntheticInputScope() { --guard.synthetic_depth; }
+    SyntheticInputScope(const SyntheticInputScope&)=delete;
+    SyntheticInputScope& operator=(const SyntheticInputScope&)=delete;
+};
+inline bool point_valid(int x, int y, int width, int height)
+{
+    return width > 0 && height > 0 && x >= 0 && y >= 0 && x < width && y < height;
+}
+inline bool modifiers_valid(int modifiers) { return modifiers >= 0 && modifiers <= 3; }
+// Native CApp clears these tooltip display fields once before its UI loop.
+// A synthetic batch can visit several controls after that loop, so clear only
+// the display cache before recomputing each point's hover. Preserve armed
+// targeting, drag/cursor state and the normal tooltip delay/history.
+template<class Mouse> void clear_pointer_tooltip(Mouse& mouse)
+{
+    mouse.tooltip.clear();
+    mouse.tooltipTitle.clear();
+    mouse.bForceTooltip=false;
+    mouse.overrideTooltipWidth=-1;
+    mouse.staticTooltip.x=-1;
+    mouse.staticTooltip.y=-1;
+}
+// CApp::OnMouseMove updates the native cursor; GUI hover is normally deferred
+// until a later UI loop. A click primitive must refresh the same normal hover
+// handler before Down/Up, without running simulation or changing hover bits.
+template<class App> void mouse_move(App& app,int x,int y,int dx=0,int dy=0,bool left=false,bool right=false,
+                                   void (*before_hover)()=nullptr)
+{
+    if (before_hover) before_hover();
+    app.OnMouseMove(x,y,dx,dy,left,right,false);
+    const auto position=app.TranslateMouse(x,y);
+    if (app.langChooser.bOpen) return; // CApp already forwards this active window
+    if (app.menu.bOpen) app.menu.MouseMove(position.x,position.y);
+    else if (app.gui) app.gui->MouseMove(position.x,position.y);
+}
+template<class App> void mouse_click(App& app,int x,int y,int button,void (*before_hover)()=nullptr)
+{
+    mouse_move(app,x,y,0,0,false,false,before_hover);
+    if (button==0) { app.OnLButtonDown(x,y); app.OnLButtonUp(x,y); }
+    else { app.OnRButtonDown(x,y); app.OnRButtonUp(x,y); }
+}
+template<class App> void mouse_drag(App& app,int x,int y,int to_x,int to_y,int button,void (*before_hover)()=nullptr)
+{
+    mouse_move(app,x,y,0,0,false,false,before_hover);
+    if (button==0) app.OnLButtonDown(x,y); else app.OnRButtonDown(x,y);
+    const int steps=std::max(1,std::min(64,std::max(std::abs(to_x-x),std::abs(to_y-y))/12+1));
+    int previous_x=x,previous_y=y;
+    for (int i=1;i<=steps;++i) {
+        const int next_x=x+(to_x-x)*i/steps,next_y=y+(to_y-y)*i/steps;
+        mouse_move(app,next_x,next_y,next_x-previous_x,next_y-previous_y,button==0,button==1,before_hover);
+        previous_x=next_x; previous_y=next_y;
+    }
+    if (button==0) app.OnLButtonUp(to_x,to_y); else app.OnRButtonUp(to_x,to_y);
+}
+inline int polled_key_state(int modifiers,int key,int physical)
+{
+    if (modifiers >= 0) {
+        if (key == 0x4b || key == 0x4c) return (modifiers & 1) != 0;
+        if (key == 0x4d || key == 0x4e) return (modifiers & 2) != 0;
+    }
+    return physical;
+}
+template<class App> struct ModifierScope {
+    App& app;
+    int& injected;
+    bool shift, ctrl;
+    int previous;
+    ModifierScope(App& target,int& state,int modifiers) : app(target),injected(state),
+        shift(target.shift_held),ctrl(target.lCtrl),previous(state)
+    {
+        injected=modifiers; app.shift_held=(modifiers&1)!=0; app.lCtrl=(modifiers&2)!=0;
+    }
+    ~ModifierScope() { app.shift_held=shift; app.lCtrl=ctrl; injected=previous; }
+};
+inline int key_code(const std::string& key)
+{
+    if (key.size() == 1 && ((key[0] >= 'a' && key[0] <= 'z') ||
+        (key[0] >= '0' && key[0] <= '9') || std::strchr("`-=[]\\;',./", key[0]))) return key[0];
+    struct Key { const char* name; int code; };
+    const Key keys[] = {{"space",32},{"escape",27},{"enter",13},{"tab",9},
+        {"backspace",8},{"delete",127},{"up",0x111},{"down",0x112},
+        {"right",0x113},{"left",0x114},{"insert",0x115},{"home",0x116},
+        {"end",0x117},{"pageup",0x118},{"pagedown",0x119},
+        {"f1",0x11a},{"f2",0x11b},{"f3",0x11c},{"f4",0x11d},
+        {"f5",0x11e},{"f6",0x11f},{"f7",0x120},{"f8",0x121},
+        {"f9",0x122},{"f10",0x123},{"f11",0x124},{"f12",0x125}};
+    for (const auto& entry : keys) if (key == entry.name) return entry.code;
+    return -1;
+}
+inline void be32(std::vector<unsigned char>& out, uint32_t value)
+{
+    for (int shift = 24; shift >= 0; shift -= 8) out.push_back((value >> shift) & 255);
+}
+inline uint32_t crc32(const unsigned char* data, size_t size)
+{
+    uint32_t crc = 0xffffffff;
+    for (size_t i = 0; i < size; ++i) {
+        crc ^= data[i];
+        for (int bit = 0; bit < 8; ++bit) crc = (crc >> 1) ^ (0xedb88320U & (0U - (crc & 1)));
+    }
+    return ~crc;
+}
+inline void chunk(std::vector<unsigned char>& out, const char* type, const std::vector<unsigned char>& data)
+{
+    be32(out, static_cast<uint32_t>(data.size()));
+    const size_t begin = out.size();
+    out.insert(out.end(), type, type + 4);
+    out.insert(out.end(), data.begin(), data.end());
+    be32(out, crc32(out.data() + begin, out.size() - begin));
+}
+// SIL readback is bottom-to-top RGBA8. PNG is top-to-bottom RGB8. Stored DEFLATE
+// blocks avoid backend/codec dependencies and preserve every rendered pixel.
+inline std::vector<unsigned char> png(const std::vector<unsigned char>& rgba, int width, int height)
+{
+    if (width <= 0 || height <= 0 || width > 8192 || height > 8192 ||
+        rgba.size() != static_cast<size_t>(width) * height * 4) return {};
+    std::vector<unsigned char> raw;
+    raw.reserve(static_cast<size_t>(width * 3 + 1) * height);
+    for (int y = height - 1; y >= 0; --y) {
+        raw.push_back(0); // PNG filter None
+        for (int x = 0; x < width; ++x) {
+            const size_t offset = (static_cast<size_t>(y) * width + x) * 4;
+            raw.insert(raw.end(), rgba.begin() + offset, rgba.begin() + offset + 3);
+        }
+    }
+    std::vector<unsigned char> compressed = {0x78, 0x01};
+    for (size_t offset = 0; offset < raw.size();) {
+        const unsigned length = static_cast<unsigned>(std::min<size_t>(65535, raw.size() - offset));
+        compressed.push_back(offset + length == raw.size() ? 1 : 0);
+        compressed.push_back(length & 255); compressed.push_back(length >> 8);
+        compressed.push_back((~length) & 255); compressed.push_back(((~length) >> 8) & 255);
+        compressed.insert(compressed.end(), raw.begin() + offset, raw.begin() + offset + length);
+        offset += length;
+    }
+    uint32_t a = 1, b = 0;
+    for (const auto byte : raw) { a = (a + byte) % 65521; b = (b + a) % 65521; }
+    be32(compressed, (b << 16) | a);
+    std::vector<unsigned char> out = {137,80,78,71,13,10,26,10};
+    std::vector<unsigned char> header;
+    be32(header, width); be32(header, height);
+    header.insert(header.end(), {8,2,0,0,0});
+    chunk(out, "IHDR", header); chunk(out, "IDAT", compressed); chunk(out, "IEND", {});
+    return out;
+}
+} // namespace BenchmarkVisual
diff --git a/Benchmark_VisualEngine.inc b/Benchmark_VisualEngine.inc
new file mode 100644
index 0000000..6e08697
--- /dev/null
+++ b/Benchmark_VisualEngine.inc
@@ -0,0 +1,403 @@
+// Included in Benchmark_Extend.cpp after the existing observation transport.
+// The SIL functions are the game's backend-neutral renderer API, used by both
+// D3D11 and OpenGL. Reading before finish_frame captures the current client frame.
+#if defined(_WIN32) && defined(__i386__)
+namespace BenchmarkVisualEngine {
+    void* read_pixels_address = nullptr;
+    void* width_address = nullptr;
+    void* height_address = nullptr;
+    void* finish_address = nullptr;
+    void* key_state_address = nullptr;
+    void* mouse_position_address = nullptr;
+    const short read_args[] = {0x1ff,0x1ff,0x1ff,0x1ff,0x1ff};
+    ZHL::FunctionDefinition read_def("benchmark_graphics_read_pixels", typeid(int (*)(int,int,int,int,void*)),
+        "5589e557565383e4f083ec208b45188b55088b4d0c8b5d1085c0", read_args,5,2,&read_pixels_address);
+    ZHL::FunctionDefinition width_def("benchmark_graphics_width", typeid(int (*)()),
+        "a1????????c38d76008dbc2700000000a1????????c38d76008dbc27000000005589e583e4f083ec30", nullptr,0,2,&width_address);
+    ZHL::FunctionDefinition height_def("benchmark_graphics_height", typeid(int (*)()),
+        "a1????????c38d76008dbc27000000005589e583e4f083ec308d44242cc744242800000000", nullptr,0,2,&height_address);
+    ZHL::FunctionDefinition finish_def("benchmark_graphics_finish_frame", typeid(void (*)()),
+        "5589e583e4f0e8????????c9c38d76005589e583e4f083ec10c7042400000000", nullptr,0,6,&finish_address);
+    const short key_args[] = {0x1ff};
+    ZHL::FunctionDefinition key_def("benchmark_input_key_state", typeid(int (*)(int)),
+        "31c0803d????????0074168b4c24048d51ff81fa9000000077070fb681????????f3c3", key_args,1,2,&key_state_address);
+    const short mouse_position_args[] = {0x1ff,0x1ff};
+    ZHL::FunctionDefinition mouse_position_def("benchmark_input_mouse_position", typeid(void (*)(float*,float*)),
+        "8b5424048b44240885d2740cf30f1005????????f30f110285c0740cf30f1005????????f30f1100f3c3", mouse_position_args,2,6,&mouse_position_address);
+    BenchmarkVisual::ExternalInputGuard external_input;
+    BenchmarkVisual::FrameClock frame_clock;
+    bool in_render = false;
+    unsigned long long render_frame = 0;
+    unsigned long long capture_counter = 0;
+    const unsigned long long session_id = []() -> unsigned long long {
+        FILETIME time;
+        GetSystemTimeAsFileTime(&time);
+        return (static_cast<unsigned long long>(time.dwHighDateTime) << 32) | time.dwLowDateTime;
+    }();
+    int injected_modifiers = -1;
+    bool available() { return read_pixels_address && width_address && height_address && finish_address && key_state_address && mouse_position_address; }
+    int width() { return available() ? reinterpret_cast<int (*)()>(width_address)() : 0; }
+    int height() { return available() ? reinterpret_cast<int (*)()>(height_address)() : 0; }
+    bool point(int x,int y) { return BenchmarkVisual::point_valid(x,y,width(),height()); }
+    CApp* input_app()
+    {
+        CApp* app = Global::GetInstance()->GetCApp();
+        return available() && app && app->gui && !app->minimized ? app : nullptr;
+    }
+    void clear_pointer_tooltip()
+    {
+        MouseControl* mouse=Global::GetInstance()->GetMouseControl();
+        if (mouse) BenchmarkVisual::clear_pointer_tooltip(*mouse);
+    }
+    void refresh_pointer_hover(CApp* app)
+    {
+        MouseControl* mouse=Global::GetInstance()->GetMouseControl();
+        if (!app || !mouse) return;
+        clear_pointer_tooltip();
+        // Keyboard handlers may change the active window without moving the
+        // cursor. Recompute normal hover at its already-translated GUI point;
+        // preserve native tooltip delay and do not synthesize a mouse event.
+        const Point position=mouse->position;
+        if (app->langChooser.bOpen) app->langChooser.MouseMove(position.x,position.y);
+        else if (app->menu.bOpen) app->menu.MouseMove(position.x,position.y);
+        else if (app->gui) app->gui->MouseMove(position.x,position.y);
+    }
+    void refresh_idle_map_ui(CApp* app)
+    {
+        if (!frame_clock.owned || frame_clock.advancing || !app || !app->gui || !app->world ||
+            !app->world->bStartedGame || app->gui->gameover || app->gui->alreadyWon) return;
+        CompleteShip* ship=app->world->playerShip;
+        if (!ship || !ship->shipManager || ship->shipManager->bJumping) return;
+        StarMap& map=app->world->starMap;
+        if (!map.bOpen || map.bChoosingNewSector || map.readyToTravel ||
+            map.waiting.running || map.potentialLoc) return;
+        // CustomMap::OnLoop owns the native fuel mode and active-button cache.
+        // With sector/travel/wait work excluded, this is an ordinary UI refresh;
+        // no sector commit, UpdateDangerZone or world update can run here.
+        map.OnLoop();
+    }
+    // Scoped cached input bits plus the normal SIL poll cover native callbacks
+    // without leaving held keys behind or changing physical keyboard state.
+    using ModifierScope = BenchmarkVisual::ModifierScope<CApp>;
+}
+
+// Native pause still runs PauseLoop/GUI travel commits. Keep those world paths
+// frozen while retaining CApp input, render, and its post-loop Lua controller.
+HOOK_METHOD_PRIORITY(CApp, OnLoop, 99999, () -> void)
+{
+    BenchmarkVisualEngine::frame_clock.begin_frame();
+    super();
+}
+HOOK_METHOD_PRIORITY(CFPS, OnLoop, 99999, () -> void)
+{
+    // FTL 1.6.9 CApp::OnLoop calls this before WorldManager and CommandGui.
+    // Keep native wall-time bookkeeping and ambient UI timing, then replace
+    // only the permitted benchmark frame's base simulation factor. The value
+    // survives its render, including jump trackers; the next native OnLoop
+    // recomputes ordinary timing. Gameplay GetSpeedFactor multipliers remain
+    // in their existing hook chain, and local temporary field scales remain.
+    super();
+    if (this==Global::GetInstance()->GetCFPS())
+        BenchmarkVisual::apply_fixed_frame_speed(*this,BenchmarkVisualEngine::frame_clock);
+}
+HOOK_METHOD_PRIORITY(WorldManager, OnLoop, 99999, () -> void)
+{
+    auto& clock=BenchmarkVisualEngine::frame_clock;
+    CApp* app=Global::GetInstance()->GetCApp();
+    const bool current=app && app->world==this;
+    if (current && !clock.update_permitted()) return;
+    super();
+    if (current) clock.completed_world_update();
+}
+HOOK_METHOD_PRIORITY(WorldManager, PauseLoop, 99999, () -> void)
+{
+    auto& clock=BenchmarkVisualEngine::frame_clock;
+    CApp* app=Global::GetInstance()->GetCApp();
+    const bool current=app && app->world==this;
+    if (current && !clock.update_permitted()) return;
+    super();
+    if (current) clock.completed_world_update();
+}
+HOOK_METHOD_PRIORITY(CommandGui, OnLoop, 99999, () -> void)
+{
+    CApp* app=Global::GetInstance()->GetCApp();
+    const bool current=app && app->gui==this;
+    if (current && !BenchmarkVisualEngine::frame_clock.update_permitted()) {
+        // CApp still resets and ages tooltips every UI frame. Replay only the
+        // ordinary stationary hover after that reset, never GUI/world OnLoop.
+        BenchmarkVisualEngine::refresh_pointer_hover(app);
+        return;
+    }
+    super();
+}
+HOOK_METHOD_PRIORITY(AnimationTracker, Update, 99999, () -> void)
+{
+    if (!BenchmarkVisualEngine::frame_clock.render_permitted()) {
+        CApp* app=Global::GetInstance()->GetCApp();
+        if (app && app->world) {
+            const auto is_jump=[this](CompleteShip* ship) {
+                return ship && ship->shipManager && this==&ship->shipManager->jumpAnimation;
+            };
+            if (is_jump(app->world->playerShip)) return;
+            for (CompleteShip* ship : app->world->ships) if (is_jump(ship)) return;
+        }
+    }
+    super(); // all ordinary UI animation, including ChoiceBox openTime, continues
+}
+
+// Only the normal input-event boundary is observed. Synthetic primitives call
+// CApp handlers directly and are additionally scoped for nested native dispatch.
+HOOK_METHOD(CEvent, OnEvent, (const InputEvent* event) -> void)
+{
+    using namespace BenchmarkVisualEngine;
+    CApp* app=Global::GetInstance()->GetCApp();
+    if (event && app && this==static_cast<CEvent*>(app)) {
+        bool meaningful=false,movement=false;
+        float x=0.f,y=0.f;
+        switch (event->type) {
+        case INPUT_EVENT_MOUSE: {
+            const auto* mouse=reinterpret_cast<const MouseInputEvent*>(&event->event);
+            x=mouse->x; y=mouse->y;
+            movement=event->detail==INPUT_MOUSE_MOVE;
+            meaningful=(event->detail>=INPUT_MOUSE_LMB_DOWN && event->detail<=INPUT_MOUSE_RMB_UP) ||
+                ((event->detail==INPUT_MOUSE_SCROLL_H || event->detail==INPUT_MOUSE_SCROLL_V) && mouse->scroll!=0.f);
+            break;
+        }
+        case INPUT_EVENT_KEYBOARD:
+        case INPUT_EVENT_TEXT:
+        case INPUT_EVENT_TOUCH: meaningful=true; break;
+        case INPUT_EVENT_JOYSTICK:
+            meaningful=event->detail>=INPUT_JOYSTICK_BUTTON_DOWN && event->detail<=INPUT_JOYSTICK_STICK_CHANGE;
+            break;
+        default: break; // memory pressure and device connection are not input
+        }
+        external_input.observe(meaningful,movement,x,y);
+    }
+    super(event); // user input keeps its ordinary game behavior
+}
